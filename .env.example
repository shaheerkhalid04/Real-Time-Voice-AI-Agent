# Copy to .env and fill in. Never commit the real .env.

# Required — powers both speech-to-text (Whisper) and the agent (Llama).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional — natural text-to-speech. Without it the web UI falls back to the
# browser's built-in voice and the CLI prints the reply instead of speaking.
# Free tier: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides -------------------------------------------------------

# Voice used for replies. Default is "Rachel" from the public voice library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ASR_MODEL=whisper-large-v3-turbo
# LLM_MODEL=llama-3.3-70b-versatile
# TTS_MODEL=eleven_flash_v2_5

# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=400
# REQUEST_TIMEOUT=45

# Comma-separated list of origins allowed to call the API. Default is open.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# SYSTEM_PROMPT=You are a helpful voice assistant. Keep answers short.
